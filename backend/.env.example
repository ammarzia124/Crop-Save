# CORS Configuration (comma-separated origins)
# PRODUCTION: Replace with your actual frontend domain (e.g., https://cropsave.example.com)
# NEVER use * in production - it allows any site to call your API
# For Railway: Add https://cropsave.vercel.app to allow Vercel frontend
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://cropsave.vercel.app

# NASA POWER API
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# Model Paths
MODEL_PATH=../ml/models/random_forest.joblib
SCALER_PATH=../ml/models/scaler.pkl
COTTON_MODEL_PATH=ml_models/cotton_model.pkl

# Environment
ENVIRONMENT=development
PORT=8000
